# ═══════════════════════════════════════════════
# APPLICAZIONE
# ═══════════════════════════════════════════════
APP_NAME="Kalendarium"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.kalendarium.it
APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

FRONTEND_URL=https://kalendarium.it

# ═══════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=noscite_calendar
DB_USERNAME=noscite
DB_PASSWORD=

# ═══════════════════════════════════════════════
# CACHE, QUEUE, SESSION — Redis in produzione
# ═══════════════════════════════════════════════
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ═══════════════════════════════════════════════
# LOG — solo errori in produzione
# ═══════════════════════════════════════════════
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# ═══════════════════════════════════════════════
# EMAIL (Brevo)
# ═══════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@kalendarium.it
MAIL_FROM_NAME="Kalendarium"

# ═══════════════════════════════════════════════
# AI SERVICES
# ═══════════════════════════════════════════════
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# ═══════════════════════════════════════════════
# PAGAMENTI (Stripe)
# ═══════════════════════════════════════════════
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ═══════════════════════════════════════════════
# SOCIAL OAUTH
# ═══════════════════════════════════════════════
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ═══════════════════════════════════════════════
# AZURE AD (SSO Microsoft)
# ═══════════════════════════════════════════════
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=https://api.kalendarium.it/api/auth/azure/callback

# ═══════════════════════════════════════════════
# ERROR MONITORING
# ═══════════════════════════════════════════════
SENTRY_LARAVEL_DSN=

# ═══════════════════════════════════════════════
# FILESYSTEM
# ═══════════════════════════════════════════════
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=reverb

# ═══════════════════════════════════════════════
# VITE
# ═══════════════════════════════════════════════
VITE_APP_NAME="${APP_NAME}"
